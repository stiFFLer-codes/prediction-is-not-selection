.env
.env.*
*.key
*_secret*
aws_credentials*

# Python
__pycache__/
*.pyc
.venv/
venv/

# Local scratch
scratch_*

# Tool / local (not project work)
.claude/
.ua/
.agents/
.commandcode/
graphify-out/
scratchpad/

